{
  "name": "eml-viewer",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "type-check": "astro check",
    "license:check": "license-checker --production --summary --onlyAllow \"MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD;CC0-1.0;Unlicense;LGPL-3.0;LGPL-3.0-or-later;LGPL-2.1;LGPL-2.1-or-later;Python-2.0;CC-BY-4.0\"",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/preact": "^3.5.3",
    "astro": "^4.16.18",
    "dompurify": "^3.4.11",
    "postal-mime": "^2.7.5",
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.39.4",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.7.0",
    "jsdom": "^25.0.1",
    "license-checker": "^25.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^2.1.9"
  },
  "license": "MIT"
